# Copy this file to .env and fill in your own keys. .env is git-ignored — never commit real keys.
# Any engine without a key is skipped on a run.

OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Optional: override the model each engine uses (defaults are in packages/collector/src/engines/).
# OPENAI_MODEL=
# PERPLEXITY_MODEL=
# GEMINI_MODEL=
