# Copy this file to .env and fill in your own keys. .env is git-ignored — never commit real keys.
# Any engine without a key is skipped on a run.

OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Hard monthly spending cap in USD across all engines (required for real runs).
# A run stops before any call that could push this calendar month's (UTC) spend past the cap.
BUDGET_USD=10

# Optional: override the model each engine uses. Defaults: gpt-5-mini, perplexity/sonar, gemini-3.5-flash-lite.
# Add prices for any new model in packages/collector/src/pricing.ts, or the budget guard will reserve
# a pessimistic $0.10 per call for it.
# OPENAI_MODEL=
# PERPLEXITY_MODEL=
# GEMINI_MODEL=
